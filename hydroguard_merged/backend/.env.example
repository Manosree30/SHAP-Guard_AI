# HydroGuard-XAI Backend Production Environment Variables

# Port to bind server (Set automatically by Render, Railway, Heroku)
PORT=8000

# Allowed CORS Origins (Comma-separated or '*' for all)
# Example: CORS_ORIGINS=https://hydroguard-xai.vercel.app,https://hydroguard-xai.netlify.app
CORS_ORIGINS=*

# Environment mode (production / development)
ENVIRONMENT=production
